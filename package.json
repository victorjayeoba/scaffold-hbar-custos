{
  "name": "sh",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/nextjs",
      "packages/foundry"
    ]
  },
  "scripts": {
    "foundry:account": "yarn workspace @sh/foundry account",
    "foundry:account:generate": "yarn workspace @sh/foundry account:generate",
    "foundry:account:import": "yarn workspace @sh/foundry account:import",
    "foundry:account:reveal-pk": "yarn workspace @sh/foundry account:reveal-pk",
    "foundry:chain": "yarn workspace @sh/foundry chain",
    "foundry:clean": "yarn workspace @sh/foundry clean",
    "foundry:compile": "yarn workspace @sh/foundry compile",
    "foundry:test": "yarn workspace @sh/foundry test",
    "foundry:deploy": "yarn workspace @sh/foundry deploy",
    "foundry:deploy:testnet": "yarn foundry:deploy --network hedera_testnet",
    "foundry:deploy:mainnet": "yarn foundry:deploy --network hedera_mainnet",
    "custos:deploy:testnet": "yarn workspace @sh/foundry custos deploy",
    "custos:start:testnet": "yarn workspace @sh/foundry custos start",
    "custos:demo:testnet": "yarn workspace @sh/foundry custos demo",
    "custos:revive:testnet": "yarn workspace @sh/foundry custos revive",
    "custos:check-market:testnet": "yarn workspace @sh/foundry custos check-market",
    "foundry:flatten": "yarn workspace @sh/foundry flatten",
    "foundry:fork": "yarn workspace @sh/foundry fork",
    "foundry:format": "yarn workspace @sh/foundry format",
    "foundry:lint": "yarn workspace @sh/foundry lint",
    "foundry:verify:testnet": "yarn workspace @sh/foundry verify:testnet",
    "foundry:verify:mainnet": "yarn workspace @sh/foundry verify:mainnet",
    "format": "yarn next:format && yarn foundry:format",
    "lint": "yarn next:lint && yarn foundry:lint",
    "docs:check": "node scripts/check-docs.mjs",
    "harness:doctor": "hedera-harness doctor .harness/spec.yaml",
    "harness:validate": "hedera-harness validate .harness/spec.yaml",
    "harness:run": "hedera-harness run .harness/spec.yaml",
    "next:build": "yarn workspace @sh/nextjs build",
    "next:check-types": "yarn workspace @sh/nextjs check-types",
    "next:dev": "yarn workspace @sh/nextjs dev",
    "next:e2e": "yarn workspace @sh/nextjs e2e",
    "next:e2e:install": "yarn workspace @sh/nextjs e2e:install",
    "next:format": "yarn workspace @sh/nextjs format",
    "next:lint": "yarn workspace @sh/nextjs lint",
    "next:serve": "yarn workspace @sh/nextjs serve",
    "next:start": "yarn workspace @sh/nextjs start",
    "postinstall": "husky",
    "precommit": "lint-staged",
    "lint-staged": "lint-staged"
  },
  "packageManager": "yarn@3.2.3",
  "devDependencies": {
    "@hiero-ledger/sdk": "^2.86.2",
    "hedera-harness": "1.2.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "playwright": "1.63.0",
    "prettier": "3.8.1"
  },
  "engines": {
    "node": ">=20.18.3"
  }
}
