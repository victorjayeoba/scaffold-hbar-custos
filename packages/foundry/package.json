{
  "name": "@sh/foundry",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "account": "node scripts-js/checkAccountBalance.js",
    "account:generate": "node scripts-js/generateKeystore.js",
    "account:import": "node scripts-js/importAccount.js",
    "account:reveal-pk": "node scripts-js/revealPK.js",
    "chain": "anvil",
    "clean": "forge clean",
    "compile": "forge compile",
    "deploy": "node scripts-js/parseArgs.js",
    "flatten": "forge flatten",
    "fork": "make fork",
    "format": "forge fmt && prettier --write \"./scripts-js/**/*.js\"",
    "lint": "forge fmt --check && forge lint && prettier --check \"./scripts-js/**/*.js\"",
    "test": "forge test",
    "verify:testnet": "forge verify-contract --chain-id 296 --verifier sourcify",
    "verify:mainnet": "forge verify-contract --chain-id 295 --verifier sourcify",
    "postinstall": "shx cp -n .env.example .env",
    "custos": "node scripts-js/custos.js",
    "check-markets": "node scripts-js/checkMarkets.js"
  },
  "dependencies": {
    "dotenv": "~16.3.1",
    "envfile": "~6.18.0",
    "ethers": "~5.7.1",
    "prettier": "~2.8.8",
    "qrcode": "~1.5.3",
    "toml": "~3.0.0"
  },
  "devDependencies": {
    "shx": "^0.3.4"
  }
}
