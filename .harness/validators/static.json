{
  "name": "custos-eth-usd-market-static",
  "description": "ETH-USD is in markets.json with the right feeds, HBAR-USD is untouched, the ETH test exists where AGENTS.md puts it, the README lists the market, and no root or app env file is in the workspace. (packages/foundry/.env is allowed: the template's postinstall copies it from .env.example, and it holds no secrets.)",
  "jsonAssertions": [
    { "file": "package.json", "path": "packageManager", "equals": "yarn@3.2.3" },
    { "file": "packages/foundry/package.json", "path": "name", "equals": "@sh/foundry" }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      ".harness/spec.yaml",
      ".harness/prd.md",
      "packages/foundry/markets.json",
      "packages/foundry/scripts-js/checkMarkets.js",
      "packages/foundry/test/Markets.t.sol",
      "packages/foundry/test/markets/EthUsdMarket.t.sol"
    ],
    "forbidden": [
      ".env",
      "packages/nextjs/.env",
      "packages/nextjs/.env.local"
    ]
  },
  "textAssertions": [
    {
      "file": "packages/foundry/markets.json",
      "contains": [
        "\"ETH-USD\"",
        "0xb9d461e0b962aF219866aDfA7DD19C52bB9871b9",
        "\"supraPair\": 19",
        "\"HBAR-USD\"",
        "0x59bC155EB6c6C415fE43255aF66EcF0523c92B4a",
        "\"supraPair\": 75"
      ]
    },
    {
      "file": "packages/foundry/test/markets/EthUsdMarket.t.sol",
      "contains": ["ETH-USD", "markets.json", "isLiquidatable", "tick()"]
    },
    {
      "file": "AGENTS.md",
      "contains": ["markets.json", "check-market"]
    },
    {
      "file": "README.md",
      "contains": ["| ETH-USD |", "| HBAR-USD |"]
    }
  ]
}
